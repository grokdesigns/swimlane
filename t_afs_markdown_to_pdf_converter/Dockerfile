# syntax=docker/dockerfile:1.2
ARG BASE_COMPILE_IMAGE_NAME=quay.io/swimlane/connector-python-compile-definition-base:3.11-latest
ARG RUNNER_IMAGE_NAME=quay.io/swimlane/connector-python-runner-definition-base:3.11-latest
ARG RUNTIME_IMAGE=runtime-image
ARG DEBUG=false
FROM ${BASE_COMPILE_IMAGE_NAME} AS compile-image

COPY compile.* /scripts/
RUN if [ $(stat -c %s  "/scripts/compile.txt") -ne 0 ]; then apt-get update &&  xargs -a /scripts/compile.txt apt-get install -y --no-install-recommends; fi
RUN if [ $(stat -c %s  "/scripts/compile.sh") -ne 0 ]; then chmod +x /scripts/compile.sh && /scripts/compile.sh; fi
RUN rm -rf /scripts

# Install OS packages
COPY requirements.txt .
RUN pip install --user -r requirements.txt

FROM ${RUNNER_IMAGE_NAME} AS runtime-image
ARG ASSET_KEYS
ENV ASSET_KEYS=$ASSET_KEYS
RUN if [[ -z "DEBUG" ]] ; then echo 'DEBUG not enabled' ; else echo 'DEBUG is enabled'; pip install debugpy ; fi
COPY runner.* /scripts/

RUN if [ $(stat -c %s  "/scripts/runner.txt") -ne 0 ]; then apt-get update && xargs -a /scripts/runner.txt apt-get install -y --no-install-recommends; fi
RUN if [ $(stat -c %s "/scripts/runner.sh") -ne 0 ]; then chmod +x /scripts/runner.sh && /scripts/runner.sh; fi
RUN rm -rf /scripts

COPY --from=compile-image /root/.local /root/.local

ENV PATH=/root/.local/bin:$PATH

COPY connector /app
WORKDIR /app
ENTRYPOINT ["python", "run.py"]

FROM ${RUNTIME_IMAGE} AS connector-image
LABEL org.opencontainers.image.title="AFS Markdown to PDF Converter"
LABEL org.opencontainers.image.description="Converts Markdown text to styled PDF documents with AFS purple theme"
LABEL org.opencontainers.image.version="1.0.1"
LABEL org.opencontainers.image.authors="Chris Caraccioli"
LABEL org.opencontainers.image.licenses="AGPL-3.0"
LABEL org.opencontainers.image.url="https://swimlane.com"
LABEL org.opencontainers.image.source="https://github.com/swimlane-connectors/t_afs_markdown_to_pdf_converter"
LABEL io.swimlane.connector=""
LABEL io.swimlane.connector.actions.process_report_response=""
LABEL io.swimlane.connector.readme=""
LABEL io.swimlane.connector.icon-image=""
LABEL io.swimlane.connector.marketplace.search="true"
LABEL io.swimlane.connector.docs.changelog=""
LABEL io.swimlane.connector.docs.external_readme=""
LABEL io.swimlane.connector.docs.readme=""
LABEL io.swimlane.connector.digest.documentation="sha256:6d273e359b13b4990c8f48e1c5f6564a5646257c6fd27bfd9c96f7eecff94a5f"
LABEL io.swimlane.connector.digest.manifests="sha256:377d76af095be17842bb618fb72505446ea445a5881a2519460f4df90a1b9979"
LABEL io.swimlane.connector.digest.code="sha256:642c296b1087d55f81c9fa38b0ed663c6b450ec438bff57a052986df533e0d03"
